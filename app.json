{
  "expo": {
    "name": "goshop",
    "slug": "goshop",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo.jpg",
    "scheme": "goshop",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#ffffff",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#22c55e",
          "image": "./assets/images/logo.jpg",
          "imageWidth": 128
        }
      ],
      "expo-font",
      "expo-web-browser",
      "expo-image",
      "expo-status-bar",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow GoShop to use your location to set a delivery address."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
